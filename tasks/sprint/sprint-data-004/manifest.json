      }
    },
    {
      "caps": {
        "completeness": 15
      },
      "check": "regex_all",
      "id": "anomalies_named",
      "params": {
        "patterns": [
          "duplicate",
          "credit",
          "missing"
        ]
      }
    },
    {
      "caps": {
        "instruction_adherence": 5
      },
      "check": "word_count",
      "id": "report_length",
      "params": {
        "max": 500,
        "min": 60
      }
    }
