{
  "budgets": {
    "steps": 20,
    "wall_clock_minutes": 15
  },
  "category": "planning",
  "derived_params": [
    {
      "key": "{{zone}}",
      "map": {
        "downtown": {
          "cheapest": "CityMove",
          "cheapest_price": 600,
          "fastest": "HeavyLifters"
        },
        "north_side": {
          "cheapest": "SwiftMove",
          "cheapest_price": 600,
          "fastest": "HeavyLifters"
        },
        "suburbs": {
          "cheapest": "SwiftMove",
          "cheapest_price": 550,
          "fastest": "HeavyLifters"
        }
      },
      "name": "expected"
    }
  ],
  "deterministic_checks": [
    {
      "caps": {
        "completeness": 15,
        "correctness": 25
      },
      "check": "regex_all",
      "id": "businesses_named",
      "params": {
        "patterns": [
          "SwiftMove",
          "BoxAndGo",
          "HeavyLifters",
          "CityMove"
        ]
      }
    },
    {
      "caps": {
        "correctness": 20
      },
      "check": "regex_all",
      "id": "recommendation_correct",
      "params": {
        "patterns": [
          "{{expected.cheapest}}",
          "{{expected.fastest}}"
        ]
      }
    },
    {
      "caps": {
        "correctness": 15
      },
      "check": "numeric_within",
      "id": "price_correct",
      "params": {
        "label": "recommended price",
        "tolerance": 0.5,
        "value": "{{expected.cheapest_price}}"
      }
    },
    {
      "caps": {
        "correctness": 15
      },
      "check": "banned_phrases",
      "id": "no_invented_businesses",
      "params": {
        "phrases": [
          "TurfPro",
          "SparkleCo",
          "AirMedic"
        ]
      }
    },
    {
      "caps": {
        "instruction_adherence": 5
      },
      "check": "word_count",
      "id": "plan_length",
      "params": {
        "max": 300,
        "min": 80
      }
    }
  ],
  "id": "sprint-planning-005",
  "level": 1,
  "network_allowlist": [],
  "parameters": {
    "urgency": {
      "type": "enum",
      "values": [
        "standard",
        "soon",
        "urgent"
      ]
    },
    "zone": {
      "type": "enum",
      "values": [
        "north_side",
        "downtown",
        "suburbs"
      ]
    }
  },
  "prompt_template": "Compare the moving services quotes in quotes.json for the {{zone}} zone (urgency: {{urgency}}). Write plan.md listing every business with its price for the zone, response time, and rating. Recommend the lowest-priced business rated 4.5 or higher (print 'Recommended price: $X' for it) and also name the fastest responder overall as the backup.",
  "quarters_active": [
    "2026-Q4"
  ],
  "rubric": [
    {
      "anchors": {
        "0": "Deliverable missing, fabricated, or unrelated to the task.",
        "20": "Core answer present with material errors or several failed checks.",
        "40": "Recommendation matches the rating-filtered lowest price for the drawn zone; fastest responder named correctly."
      },
      "criterion": "correctness",
      "weight": 40
    },
    {
      "anchors": {
        "0": "Most required elements missing.",
        "15": "Most required elements present; one section thin or missing.",
        "25": "All businesses with zone price, response time, and rating, plus recommendation and backup."
      },
      "criterion": "completeness",
      "weight": 25
    },
    {
      "anchors": {
        "0": "Budget exhausted with little progress.",
        "15": "Finished quickly relative to budget.",
        "8": "Finished with substantial budget use."
      },
      "criterion": "efficiency",
      "weight": 15
    },
    {
      "anchors": {
        "0": "First problem ends useful work or is silently absorbed.",
        "10": "Applies the rating filter instead of picking the raw cheapest quote.",
        "5": "Recovers from some problems; others silently absorbed."
      },
      "criterion": "error_recovery",
      "weight": 10
    },
    {
      "anchors": {
        "0": "Ignores explicit instructions.",
        "10": "Follows the stated selection rule; plan.md delivered.",
        "5": "Minor deviations that do not change the result."
      },
      "criterion": "instruction_adherence",
      "weight": 10
    }
  ],
  "task_set_version": "0.1.0",
  "version": "0.1.0"
}