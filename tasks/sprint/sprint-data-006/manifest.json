{
  "budgets": {
    "steps": 20,
    "wall_clock_minutes": 15
  },
  "category": "data_analysis",
  "derived_params": [
    {
      "key": "{{month}}|{{top_n}}",
      "map": {
        "aug|2": {
          "overall_rate": 4.25,
          "top_channels": [
            "organic",
            "paid"
          ],
          "total_conversions": 119.0
        },
        "aug|3": {
          "overall_rate": 4.25,
          "top_channels": [
            "organic",
            "paid",
            "email"
          ],
          "total_conversions": 119.0
        },
        "sep|2": {
          "overall_rate": 4.28,
          "top_channels": [
            "organic",
            "social"
          ],
          "total_conversions": 107.0
        },
        "sep|3": {
          "overall_rate": 4.28,
          "top_channels": [
            "organic",
            "social",
            "paid"
          ],
          "total_conversions": 107.0
        }
      },
      "name": "expected"
    }
  ],
  "deterministic_checks": [
    {
      "caps": {
        "completeness": 15,
        "correctness": 25
      },
      "check": "regex_all",
      "id": "top_named",
      "params": {
        "patterns": "{{expected.top_channels}}"
      }
    },
    {
      "caps": {
        "correctness": 20
      },
      "check": "numeric_within",
      "id": "total_correct",
      "params": {
        "label": "total conversions",
        "tolerance": 1.5,
        "value": "{{expected.total_conversions}}"
      }
    },
    {
      "caps": {
        "correctness": 15
      },
      "check": "numeric_within",
      "id": "extra_numeric",
      "params": {
        "label": "overall conversion rate",
        "tolerance": 0.1,
        "value": "{{expected.overall_rate}}"
      }
    },
    {
      "caps": {
        "completeness": 15
      },
      "check": "regex_all",
      "id": "anomalies_named",
      "params": {
        "patterns": [
          "duplicate",
          "gap",
          "invalid"
        ]
      }
    },
    {
      "caps": {
        "instruction_adherence": 5
      },
      "check": "word_count",
      "id": "report_length",
      "params": {
        "max": 500,
        "min": 60
      }
    }
  ],
  "id": "sprint-data-006",
  "level": 1,
  "network_allowlist": [],
  "parameters": {
    "month": {
      "type": "enum",
      "values": [
        "aug",
        "sep"
      ]
    },
    "top_n": {
      "max": 3,
      "min": 2,
      "type": "integer"
    }
  },
  "prompt_template": "Analyze sessions.csv in the workspace. Rules: rows sharing a date and channel are a tracking double-fire and must be summed; rows with conversions above sessions are invalid and excluded. For the month {{month}}, write report.md with the total conversions, the overall conversion rate as a percent, the top {{top_n}} channels by conversions, and the data quality issues (duplicate rows, invalid rows, channel gaps).",
  "quarters_active": [
    "2026-Q4"
  ],
  "rubric": [
    {
      "anchors": {
        "0": "Deliverable missing, fabricated, or unrelated to the task.",
        "20": "Core answer present with material errors or several failed checks.",
        "40": "Figures match ground truth for the drawn instance under the stated rules."
      },
      "criterion": "correctness",
      "weight": 40
    },
    {
      "anchors": {
        "0": "Most required elements missing.",
        "15": "Most required elements present; one section thin or missing.",
        "25": "Totals, full top-N list, and every planted anomaly class named."
      },
      "criterion": "completeness",
      "weight": 25
    },
    {
      "anchors": {
        "0": "Budget exhausted with little progress.",
        "15": "Finished quickly relative to budget.",
        "8": "Finished with substantial budget use."
      },
      "criterion": "efficiency",
      "weight": 15
    },
    {
      "anchors": {
        "0": "First problem ends useful work or is silently absorbed.",
        "10": "Notices and correctly handles every planted data problem instead of absorbing it.",
        "5": "Recovers from some problems; others silently absorbed."
      },
      "criterion": "error_recovery",
      "weight": 10
    },
    {
      "anchors": {
        "0": "Ignores explicit instructions.",
        "10": "Follows the stated computation rules exactly; report.md delivered.",
        "5": "Minor deviations that do not change the result."
      },
      "criterion": "instruction_adherence",
      "weight": 10
    }
  ],
  "task_set_version": "0.1.0",
  "version": "0.1.0"
}