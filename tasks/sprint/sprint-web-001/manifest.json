{
  "budgets": {
    "steps": 20,
    "wall_clock_minutes": 15
  },
  "category": "web_research",
  "derived_params": [
    {
      "key": "{{brand_focus}}",
      "map": {
        "DustBot": {
          "model": "DustBot Pro",
          "price": "449",
          "spec": "180 min"
        },
        "NaviMop": {
          "model": "NaviMop S2",
          "price": "549",
          "spec": "240 min"
        },
        "RoboVac": {
          "model": "RoboVac X1",
          "price": "299",
          "spec": "120 min"
        }
      },
      "name": "expected"
    }
  ],
  "deterministic_checks": [
    {
      "caps": {
        "completeness": 15,
        "correctness": 25
      },
      "check": "csv_valid",
      "id": "csv_shape",
      "params": {
        "columns": [
          "model",
          "price",
          "spec",
          "source"
        ],
        "min_rows": 4
      }
    },
    {
      "caps": {
        "correctness": 20
      },
      "check": "regex_all",
      "id": "focus_row_values",
      "params": {
        "patterns": [
          "{{expected.model}}",
          "{{expected.price}}",
          "{{expected.spec}}"
        ]
      }
    },
    {
      "caps": {
        "completeness": 15
      },
      "check": "regex_all",
      "id": "all_models_present",
      "params": {
        "patterns": [
          "RoboVac X1",
          "DustBot Pro",
          "CleanSweep Mini",
          "NaviMop S2"
        ]
      }
    }
  ],
  "id": "sprint-web-001",
  "level": 1,
  "network_allowlist": [],
  "parameters": {
    "brand_focus": {
      "type": "enum",
      "values": [
        "RoboVac",
        "DustBot",
        "NaviMop"
      ]
    },
    "output_format": {
      "type": "enum",
      "values": [
        "csv",
        "spreadsheet-ready csv",
        "plain csv"
      ]
    }
  },
  "prompt_template": "Extract the robot vacuums comparison table from specs.html in the workspace into specs.csv with columns model, price, spec, source (source is the fixture filename for every row). Brand focus for this run: {{brand_focus}}. Output format: {{output_format}}.",
  "quarters_active": [
    "2026-Q4"
  ],
  "rubric": [
    {
      "anchors": {
        "0": "Deliverable missing, fabricated, or unrelated to the task.",
        "20": "Core answer present with material errors or several failed checks.",
        "40": "Every extracted value matches the source table exactly, including the focus brand row."
      },
      "criterion": "correctness",
      "weight": 40
    },
    {
      "anchors": {
        "0": "Most required elements missing.",
        "15": "Most required elements present; one section thin or missing.",
        "25": "All models extracted with price, spec, and source columns."
      },
      "criterion": "completeness",
      "weight": 25
    },
    {
      "anchors": {
        "0": "Budget exhausted with little progress.",
        "15": "Finished quickly relative to budget.",
        "8": "Finished with substantial budget use."
      },
      "criterion": "efficiency",
      "weight": 15
    },
    {
      "anchors": {
        "0": "First problem ends useful work or is silently absorbed.",
        "10": "Parses the table structure instead of copying rendered text blindly.",
        "5": "Recovers from some problems; others silently absorbed."
      },
      "criterion": "error_recovery",
      "weight": 10
    },
    {
      "anchors": {
        "0": "Ignores explicit instructions.",
        "10": "Exact columns and source attribution; specs.csv delivered.",
        "5": "Minor deviations that do not change the result."
      },
      "criterion": "instruction_adherence",
      "weight": 10
    }
  ],
  "task_set_version": "0.1.0",
  "version": "0.1.0"
}