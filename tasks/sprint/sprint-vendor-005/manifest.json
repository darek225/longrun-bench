{
  "budgets": {
    "steps": 20,
    "wall_clock_minutes": 15
  },
  "category": "research_synthesis",
  "derived_params": [
    {
      "key": "{{focus}}",
      "map": {
        "easiest_onboarding": {
          "recommended": "ConvertKit"
        },
        "lowest_cost": {
          "recommended": "Brevo"
        },
        "most_capable": {
          "recommended": "ConvertKit"
        }
      },
      "name": "expected"
    }
  ],
  "deterministic_checks": [
    {
      "caps": {
        "completeness": 15,
        "correctness": 25
      },
      "check": "regex_all",
      "id": "vendors_named",
      "params": {
        "patterns": [
          "Brevo",
          "Constant Contact",
          "Mailchimp",
          "Klaviyo",
          "ConvertKit"
        ]
      }
    },
    {
      "caps": {
        "correctness": 20
      },
      "check": "regex_all",
      "id": "prices_present",
      "params": {
        "patterns": [
          "9/user",
          "12/user",
          "13/user",
          "20/user",
          "29/user"
        ]
      }
    },
    {
      "caps": {
        "completeness": 15
      },
      "check": "regex_all",
      "id": "recommendation_matches_focus",
      "params": {
        "patterns": [
          "{{expected.recommended}}"
        ]
      }
    },
    {
      "caps": {
        "correctness": 15
      },
      "check": "banned_phrases",
      "id": "no_invented_vendors",
      "params": {
        "phrases": [
          "Salesforce",
          "Dialpad",
          "Gusto"
        ]
      }
    },
    {
      "caps": {
        "instruction_adherence": 5
      },
      "check": "word_count",
      "id": "brief_length",
      "params": {
        "max": 400,
        "min": 80
      }
    }
  ],
  "id": "sprint-vendor-005",
  "level": 1,
  "network_allowlist": [],
  "parameters": {
    "business_type": {
      "type": "enum",
      "values": [
        "dental_practice",
        "food_truck",
        "law_firm",
        "auto_shop"
      ]
    },
    "focus": {
      "type": "enum",
      "values": [
        "lowest_cost",
        "easiest_onboarding",
        "most_capable"
      ]
    }
  },
  "prompt_template": "Using vendors.json in the workspace, compare the email marketing platforms vendors for a {{business_type}}. Write brief.md with one line per vendor giving its name, monthly price, and key features, plus a recommendation paragraph of at least 60 words. The recommendation must fit the drawn focus: {{focus}}.",
  "quarters_active": [
    "2026-Q4"
  ],
  "rubric": [
    {
      "anchors": {
        "0": "Deliverable missing, fabricated, or unrelated to the task.",
        "20": "Core answer present with material errors or several failed checks.",
        "40": "Every deterministic check passes; vendor names and prices match vendors.json exactly; no vendor invented."
      },
      "criterion": "correctness",
      "weight": 40
    },
    {
      "anchors": {
        "0": "Most required elements missing.",
        "15": "Most required elements present; one section thin or missing.",
        "25": "All vendors with price and features, plus a recommendation matching the drawn focus."
      },
      "criterion": "completeness",
      "weight": 25
    },
    {
      "anchors": {
        "0": "Budget exhausted with little progress.",
        "15": "Finished quickly relative to budget.",
        "8": "Finished with substantial budget use."
      },
      "criterion": "efficiency",
      "weight": 15
    },
    {
      "anchors": {
        "0": "First problem ends useful work or is silently absorbed.",
        "10": "Notices data quirks in the source file and still delivers a consistent brief.",
        "5": "Recovers from some problems; others silently absorbed."
      },
      "criterion": "error_recovery",
      "weight": 10
    },
    {
      "anchors": {
        "0": "Ignores explicit instructions.",
        "10": "One line per vendor; recommendation paragraph present; brief.md delivered.",
        "5": "Minor deviations that do not change the result."
      },
      "criterion": "instruction_adherence",
      "weight": 10
    }
  ],
  "task_set_version": "0.1.0",
  "version": "0.1.0"
}