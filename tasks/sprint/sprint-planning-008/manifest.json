  "prompt_template": "Plan a one-day team offsite in Nashville using options.json. The {{package}} package picks, in each category sorted by price, the option at the package tier (basic = cheapest, plus = middle, premium = priciest). For a team of {{team_size}}, write plan.md naming the venue, activity, and meal picks with per-person prices, and print the team total as 'Total for the team: $X'.",
  "quarters_active": [
    "2026-Q4"
  ],
  "rubric": [
    {
      "anchors": {
        "0": "Deliverable missing, fabricated, or unrelated to the task.",
