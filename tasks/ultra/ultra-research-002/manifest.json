{
  "budgets": {
    "steps": 500,
    "wall_clock_minutes": 1440
  },
  "category": "research_synthesis",
  "deterministic_checks": [
    {
      "caps": {
        "completeness": 15,
        "correctness": 25
      },
      "check": "regex_all",
      "id": "competitors_profiled",
      "params": {
        "patterns": [
          "ChargePoint",
          "Blink",
          "EVgo",
          "Electrify America",
          "Tesla Supercharger",
          "ABB E-mobility",
          "FLO",
          "Siemens",
          "Wallbox",
          "Enel X Way"
        ]
      }
    },
    {
      "caps": {
        "correctness": 20
      },
      "check": "regex_all",
      "id": "regulations_addressed",
      "params": {
        "patterns": [
          "NEVI",
          "Florida Statutes 366.94",
          "FDOT EV Master Plan"
        ]
      }
    },
    {
      "caps": {
        "completeness": 15
      },
      "check": "regex_all",
      "id": "risk_register_complete",
      "params": {
        "patterns": [
          "Risk 1",
          "Risk 2",
          "Risk 3",
          "Risk 4",
          "Risk 5",
          "Risk 6",
          "Risk 7",
          "Risk 8"
        ]
      }
    },
    {
      "caps": {
        "instruction_adherence": 5
      },
      "check": "word_count",
      "id": "dossier_length",
      "params": {
        "max": 6000,
        "min": 2200
      }
    }
  ],
  "id": "ultra-research-002",
  "level": 3,
  "network_allowlist": [],
  "parameters": {
    "posture": {
      "type": "enum",
      "values": [
        "aggressive",
        "measured",
        "partnership-led"
      ]
    },
    "region_focus": {
      "type": "enum",
      "values": [
        "single metro first",
        "statewide",
        "two metros"
      ]
    }
  },
  "prompt_template": "Produce a market-entry dossier for public EV charging in Florida (2200-6000 words) in dossier.md, working in stages and keeping a memory.md updated between stages. Profile every competitor in competitors.json, address every framework named in regulations.md, include a risk register with items labeled Risk 1 through Risk 8, and close with a sequenced recommendation. Region focus: {{region_focus}}; posture: {{posture}}.",
  "quarters_active": [
    "2026-Q4"
  ],
  "rubric": [
    {
      "anchors": {
        "0": "Deliverable missing, fabricated, or unrelated to the task.",
        "20": "Core answer present with material errors or several failed checks.",
        "40": "All competitors and regulatory frameworks covered accurately from the source pack."
      },
      "criterion": "correctness",
      "weight": 40
    },
    {
      "anchors": {
        "0": "Most required elements missing.",
        "15": "Most required elements present; one section thin or missing.",
        "25": "Profiles, regulation, 8-risk register, and recommendation all present at length."
      },
      "criterion": "completeness",
      "weight": 25
    },
    {
      "anchors": {
        "0": "Budget exhausted with little progress.",
        "15": "Finished quickly relative to budget.",
        "8": "Finished with substantial budget use."
      },
      "criterion": "efficiency",
      "weight": 15
    },
    {
      "anchors": {
        "0": "First problem ends useful work or is silently absorbed.",
        "10": "Uses the staged memory protocol and recovers context between stages.",
        "5": "Recovers from some problems; others silently absorbed."
      },
      "criterion": "error_recovery",
      "weight": 10
    },
    {
      "anchors": {
        "0": "Ignores explicit instructions.",
        "10": "Memory file maintained; dossier.md delivered.",
        "5": "Minor deviations that do not change the result."
      },
      "criterion": "instruction_adherence",
      "weight": 10
    }
  ],
  "task_set_version": "0.1.0",
  "version": "0.1.0"
}