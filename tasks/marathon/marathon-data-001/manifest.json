          ],
          "total_revenue": 1350.0
        }
      },
      "name": "expected"
    }
  ],
  "deterministic_checks": [
    {
      "caps": {
        "completeness": 15,
        "correctness": 25
      },
      "check": "regex_all",
      "id": "top_products_named",
      "params": {
        "patterns": "{{expected.top_products}}"
      }
    },
    {
      "caps": {
        "correctness": 20
      },
      "check": "numeric_within",
      "id": "total_correct",
      "params": {
        "label": "total revenue",
        "tolerance": 1.5,
        "value": "{{expected.total_revenue}}"
      }
    },
    {
      "caps": {
        "completeness": 15
      },
      "check": "regex_all",
      "id": "anomalies_named",
      "params": {
        "patterns": [
          "orphan",
          "return"
        ]
      }
    },
    {
      "caps": {
        "instruction_adherence": 5
      },
      "check": "word_count",
      "id": "report_length",
      "params": {
        "max": 600,
        "min": 150
      }
    }
  ],
  "id": "marathon-data-001",
  "level": 2,
  "network_allowlist": [],
  "parameters": {
    "region": {
      "type": "enum",
      "values": [
        "north",
        "south",
        "west"
      ]
    },
    "top_n": {
      "max": 3,
      "min": 2,
      "type": "integer"
    }
  },
  "prompt_template": "Join orders.csv with returns.csv on order_id. Net revenue subtracts returned quantities. Returns referencing nonexistent orders are orphan rows: exclude and flag them. For the {{region}} region, write report.md with the total revenue (net), the top {{top_n}} products by net revenue, and the method plus data quality notes (orphan returns). Length 150-600 words.",
  "quarters_active": [
    "2026-Q4"
  ],
  "rubric": [
    {
      "anchors": {
        "0": "Deliverable missing, fabricated, or unrelated to the task.",
        "20": "Core answer present with material errors or several failed checks.",
        "40": "Net revenue and top products match the joined ground truth."
      },
      "criterion": "correctness",
      "weight": 40
    },
    {
      "anchors": {
        "0": "Most required elements missing.",
        "15": "Most required elements present; one section thin or missing.",
        "25": "Totals, top-N, method, and anomaly notes complete."
      },
      "criterion": "completeness",
      "weight": 25
    },
    {
      "anchors": {
        "0": "Budget exhausted with little progress.",
        "15": "Finished quickly relative to budget.",
        "8": "Finished with substantial budget use."
      },
      "criterion": "efficiency",
      "weight": 15
    },
    {
      "anchors": {
        "0": "First problem ends useful work or is silently absorbed.",
        "10": "Handles the orphan return explicitly instead of dropping it silently.",
        "5": "Recovers from some problems; others silently absorbed."
      },
      "criterion": "error_recovery",
      "weight": 10
    },
    {
      "anchors": {
        "0": "Ignores explicit instructions.",
        "10": "Rules followed; report.md delivered.",
        "5": "Minor deviations that do not change the result."
      },
      "criterion": "instruction_adherence",
      "weight": 10
    }
  ],
  "task_set_version": "0.1.0",
  "version": "0.1.0"
}