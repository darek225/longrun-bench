{
  "budgets": {
    "steps": 100,
    "wall_clock_minutes": 180
  },
  "category": "planning",
  "derived_params": [
    {
      "key": "{{hotel_tier}}",
      "map": {
        "mid": {
          "flight": "BudgetAir",
          "flight_url": "flights.example/ba175",
          "hotel": "Loop Lodge",
          "hotel_url": "hotels.example/ll150",
          "per_person": 625.0
        },
        "upscale": {
          "flight": "BudgetAir",
          "flight_url": "flights.example/ba175",
          "hotel": "The Palmer",
          "hotel_url": "hotels.example/tp320",
          "per_person": 1135.0
        }
      },
      "name": "expected"
    }
  ],
  "deterministic_checks": [
    {
      "caps": {
        "completeness": 15,
        "correctness": 25
      },
      "check": "regex_all",
      "id": "picks_and_sources",
      "params": {
        "patterns": [
          "{{expected.flight}}",
          "{{expected.hotel}}",
          "{{expected.flight_url}}",
          "{{expected.hotel_url}}"
        ]
      }
    },
    {
      "caps": {
        "correctness": 20
      },
      "check": "numeric_within",
      "id": "per_person_total",
      "params": {
        "label": "per-person total",
        "tolerance": 1.0,
        "value": "{{expected.per_person}}"
      }
    },
    {
      "caps": {
        "completeness": 15
      },
      "check": "regex_all",
      "id": "four_days",
      "params": {
        "patterns": [
          "Day 1",
          "Day 2",
          "Day 3",
          "Day 4"
        ]
      }
    },
    {
      "caps": {
        "instruction_adherence": 5
      },
      "check": "word_count",
      "id": "plan_length",
      "params": {
        "max": 900,
        "min": 300
      }
    }
  ],
  "id": "marathon-planning-002",
  "level": 2,
  "network_allowlist": [],
  "parameters": {
    "hotel_tier": {
      "type": "enum",
      "values": [
        "mid",
        "upscale"
      ]
    },
    "team_size": {
      "type": "enum",
      "values": [
        4,
        6,
        8
      ]
    }
  },
  "prompt_template": "Plan a 4-day conference trip to Chicago (McCormick Place) for a team of {{team_size}} using travel.json. Pick the cheapest flight and the cheapest {{hotel_tier}}-tier hotel. Write itinerary.md naming both picks with their booking source URLs, the per-person total (flight + 3 nights) printed as 'Per-person total: $X', and a Day 1 to Day 4 outline.",
  "quarters_active": [
    "2026-Q4"
  ],
  "rubric": [
    {
      "anchors": {
        "0": "Deliverable missing, fabricated, or unrelated to the task.",
        "20": "Core answer present with material errors or several failed checks.",
        "40": "Picks are the true cheapest under the rules and the per-person total is exact."
      },
      "criterion": "correctness",
      "weight": 40
    },
    {
      "anchors": {
        "0": "Most required elements missing.",
        "15": "Most required elements present; one section thin or missing.",
        "25": "Picks, sources, total, and all four days present."
      },
      "criterion": "completeness",
      "weight": 25
    },
    {
      "anchors": {
        "0": "Budget exhausted with little progress.",
        "15": "Finished quickly relative to budget.",
        "8": "Finished with substantial budget use."
      },
      "criterion": "efficiency",
      "weight": 15
    },
    {
      "anchors": {
        "0": "First problem ends useful work or is silently absorbed.",
        "10": "Handles tier filtering instead of picking the raw cheapest hotel.",
        "5": "Recovers from some problems; others silently absorbed."
      },
      "criterion": "error_recovery",
      "weight": 10
    },
    {
      "anchors": {
        "0": "Ignores explicit instructions.",
        "10": "Total format and day outline as specified; itinerary.md delivered.",
        "5": "Minor deviations that do not change the result."
      },
      "criterion": "instruction_adherence",
      "weight": 10
    }
  ],
  "task_set_version": "0.1.0",
  "version": "0.1.0"
}