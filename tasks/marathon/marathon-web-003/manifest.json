{
  "budgets": {
    "steps": 100,
    "wall_clock_minutes": 180
  },
  "category": "web_research",
  "derived_params": [
    {
      "key": "{{brand_focus}}",
      "map": {
        "DustBot": {
          "model": "DustBot Ultra",
          "price": "749",
          "spec": "300 min"
        },
        "NaviMop": {
          "model": "NaviMop Elite",
          "price": "899",
          "spec": "330 min"
        },
        "TurboSuck": {
          "model": "TurboSuck 3000",
          "price": "649",
          "spec": "260 min"
        }
      },
      "name": "expected"
    }
  ],
  "deterministic_checks": [
    {
      "caps": {
        "completeness": 15,
        "correctness": 25
      },
      "check": "csv_valid",
      "id": "csv_shape",
      "params": {
        "columns": [
          "model",
          "price",
          "spec",
          "weight",
          "source"
        ],
        "min_rows": 5
      }
    },
    {
      "caps": {
        "correctness": 20
      },
      "check": "regex_all",
      "id": "focus_row_values",
      "params": {
        "patterns": [
          "{{expected.model}}",
          "{{expected.price}}",
          "{{expected.spec}}"
        ]
      }
    },
    {
      "caps": {
        "completeness": 15
      },
      "check": "regex_all",
      "id": "all_models_present",
      "params": {
        "patterns": [
          "RoboVac Pro",
          "DustBot Ultra",
          "CleanSweep Max",
          "NaviMop Elite",
          "TurboSuck 3000"
        ]
      }
    }
  ],
  "id": "marathon-web-003",
  "level": 2,
  "network_allowlist": [],
  "parameters": {
    "brand_focus": {
      "type": "enum",
      "values": [
        "DustBot",
        "NaviMop",
        "TurboSuck"
      ]
    },
    "output_format": {
      "type": "enum",
      "values": [
        "csv",
        "plain csv",
        "spreadsheet-ready csv"
      ]
    }
  },
  "prompt_template": "Extract the full pro robot vacuums table from specs.html into specs.csv with columns model, price, spec, weight, source (source = specs.html for every row). Brand focus: {{brand_focus}}; output format: {{output_format}}.",
  "quarters_active": [
    "2026-Q4"
  ],
  "rubric": [
    {
      "anchors": {
        "0": "Deliverable missing, fabricated, or unrelated to the task.",
        "20": "Core answer present with material errors or several failed checks.",
        "40": "Every value matches the source table, including the focus row."
      },
      "criterion": "correctness",
      "weight": 40
    },
    {
      "anchors": {
        "0": "Most required elements missing.",
        "15": "Most required elements present; one section thin or missing.",
        "25": "All five models with all columns extracted."
      },
      "criterion": "completeness",
      "weight": 25
    },
    {
      "anchors": {
        "0": "Budget exhausted with little progress.",
        "15": "Finished quickly relative to budget.",
        "8": "Finished with substantial budget use."
      },
      "criterion": "efficiency",
      "weight": 15
    },
    {
      "anchors": {
        "0": "First problem ends useful work or is silently absorbed.",
        "10": "Parses structure rather than copying rendered text.",
        "5": "Recovers from some problems; others silently absorbed."
      },
      "criterion": "error_recovery",
      "weight": 10
    },
    {
      "anchors": {
        "0": "Ignores explicit instructions.",
        "10": "Exact columns and attribution; specs.csv delivered.",
        "5": "Minor deviations that do not change the result."
      },
      "criterion": "instruction_adherence",
      "weight": 10
    }
  ],
  "task_set_version": "0.1.0",
  "version": "0.1.0"
}