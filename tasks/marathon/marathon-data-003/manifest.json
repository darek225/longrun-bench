{
  "budgets": {
    "steps": 100,
    "wall_clock_minutes": 180
  },
  "category": "data_analysis",
  "derived_params": [
    {
      "key": "{{plan}}",
      "map": {
        "basic": {
          "churned": [
            "D"
          ],
          "net_mrr": 50.0
        },
        "pro": {
          "churned": [
            "B"
          ],
          "net_mrr": 350.0
        },
        "team": {
          "churned": [
            "F"
          ],
          "net_mrr": 400.0
        }
      },
      "name": "expected"
    }
  ],
  "deterministic_checks": [
    {
      "caps": {
        "correctness": 25
      },
      "check": "numeric_within",
      "id": "net_mrr_correct",
      "params": {
        "label": "net mrr",
        "tolerance": 1.0,
        "value": "{{expected.net_mrr}}"
      }
    },
    {
      "caps": {
        "completeness": 15,
        "correctness": 20
      },
      "check": "regex_all",
      "id": "churned_named",
      "params": {
        "patterns": "{{expected.churned}}"
      }
    },
    {
      "caps": {
        "instruction_adherence": 5
      },
      "check": "word_count",
      "id": "report_length",
      "params": {
        "max": 500,
        "min": 100
      }
    }
  ],
  "id": "marathon-data-003",
  "level": 2,
  "network_allowlist": [],
  "parameters": {
    "plan": {
      "type": "enum",
      "values": [
        "pro",
        "basic",
        "team"
      ]
    },
    "view": {
      "type": "enum",
      "values": [
        "summary",
        "detail",
        "executive"
      ]
    }
  },
  "prompt_template": "Using subscriptions.csv and churn.csv, compute for the {{plan}} plan: gross MRR, churned MRR with the churned customers named, and net MRR printed as 'Net MRR: $X'. Write report.md (100-500 words) with the retention implication. View: {{view}}.",
  "quarters_active": [
    "2026-Q4"
  ],
  "rubric": [
    {
      "anchors": {
        "0": "Deliverable missing, fabricated, or unrelated to the task.",
        "20": "Core answer present with material errors or several failed checks.",
        "40": "Net MRR exact and churned customers named for the drawn plan."
      },
      "criterion": "correctness",
      "weight": 40
    },
    {
      "anchors": {
        "0": "Most required elements missing.",
        "15": "Most required elements present; one section thin or missing.",
        "25": "Gross, churn, net, and implications all present."
      },
      "criterion": "completeness",
      "weight": 25
    },
    {
      "anchors": {
        "0": "Budget exhausted with little progress.",
        "15": "Finished quickly relative to budget.",
        "8": "Finished with substantial budget use."
      },
      "criterion": "efficiency",
      "weight": 15
    },
    {
      "anchors": {
        "0": "First problem ends useful work or is silently absorbed.",
        "10": "Distinguishes gross from net instead of reporting headline MRR.",
        "5": "Recovers from some problems; others silently absorbed."
      },
      "criterion": "error_recovery",
      "weight": 10
    },
    {
      "anchors": {
        "0": "Ignores explicit instructions.",
        "10": "Format followed; report.md delivered.",
        "5": "Minor deviations that do not change the result."
      },
      "criterion": "instruction_adherence",
      "weight": 10
    }
  ],
  "task_set_version": "0.1.0",
  "version": "0.1.0"
}